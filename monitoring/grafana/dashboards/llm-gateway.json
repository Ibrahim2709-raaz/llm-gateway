      "options": {"colorMode": "value", "graphMode": "area", "textMode": "auto"},
      "targets": [{"expr": "sum(increase(llm_gateway_requests_total[$__range]))", "refId": "A"}],
      "title": "Requests in range",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}},
      "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0},
      "id": 2,
      "options": {"colorMode": "value", "graphMode": "area", "textMode": "auto"},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(llm_gateway_request_duration_seconds_bucket[5m])))", "refId": "A"}],
      "title": "P95 latency",
      "type": "stat"
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "fieldConfig": {"defaults": {"unit": "percentunit", "min": 0, "max": 1}},
