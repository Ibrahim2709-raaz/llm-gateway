APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
REDIS_URL=redis://localhost:6379/0
DEPENDENCY_CHECK_TIMEOUT_SECONDS=1
REQUEST_RATE_LIMIT=60
REQUEST_RATE_LIMIT_WINDOW_SECONDS=60
PORTAL_EMAIL_RATE_LIMIT=5
PORTAL_EMAIL_RATE_LIMIT_WINDOW_SECONDS=900
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=300
INTELLIGENT_ROUTING_ENABLED=false
INTELLIGENT_ROUTING_SHADOW_ENABLED=false
INTELLIGENT_ROUTING_CANARY_PERCENT=100
INTELLIGENT_ROUTING_CUSTOMER_ALLOWLIST=
INTELLIGENT_ROUTING_REQUIRED_POLICY_VERSION=
INTELLIGENT_ROUTING_REQUIRED_SCORE_VERSION=
MAX_REQUEST_BODY_BYTES=1048576
TRUSTED_HOSTS=*
GATEWAY_API_KEY_PEPPER=replace-with-a-long-random-secret
BROWSER_SESSION_TTL_SECONDS=604800
BROWSER_SESSION_TOUCH_INTERVAL_SECONDS=300
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
ORGANIZATION_INVITATION_TTL_SECONDS=604800
# Use "response" only for local development, "smtp" for real delivery, or "disabled".
PORTAL_ACTION_TOKEN_DELIVERY=response
PORTAL_PUBLIC_BASE_URL=http://localhost:8000
GRAFANA_PUBLIC_URL=http://localhost:3000/d/llm-gateway-overview/llm-gateway-overview
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=LLM Gateway
SMTP_TIMEOUT_SECONDS=10
POSTGRES_DB=gateway
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_CONTEXT_WINDOW_TOKENS=
OPENAI_TIMEOUT_SECONDS=30
OPENAI_INPUT_COST_PER_MILLION_USD=2
OPENAI_OUTPUT_COST_PER_MILLION_USD=12
OPENAI_ESTIMATED_LATENCY_MS=1500
OPENAI_QUALITY_SCORE=0.9
ANTHROPIC_ENABLED=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_CONTEXT_WINDOW_TOKENS=
ANTHROPIC_TIMEOUT_SECONDS=30
ANTHROPIC_INPUT_COST_PER_MILLION_USD=2
ANTHROPIC_OUTPUT_COST_PER_MILLION_USD=10
ANTHROPIC_ESTIMATED_LATENCY_MS=1800
ANTHROPIC_QUALITY_SCORE=0.92
LOCAL_ENABLED=false
LOCAL_BASE_URL=http://localhost:11434/v1
LOCAL_API_KEY=ollama
LOCAL_MODEL=qwen3:8b
LOCAL_CONTEXT_WINDOW_TOKENS=
LOCAL_TIMEOUT_SECONDS=60
LOCAL_INPUT_COST_PER_MILLION_USD=0
LOCAL_OUTPUT_COST_PER_MILLION_USD=0
LOCAL_ESTIMATED_LATENCY_MS=2500
LOCAL_QUALITY_SCORE=0.7
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BASE_DELAY_SECONDS=0.25
PROVIDER_RETRY_MAX_DELAY_SECONDS=2
PROVIDER_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
PROVIDER_CIRCUIT_BREAKER_RECOVERY_SECONDS=30
